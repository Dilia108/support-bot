# Copy this file to .env and fill it in.
# LANGSMITH_API_KEY is REQUIRED -- the bot will not start without it.
# The LLM provider keys are optional: without them the bot uses MockProvider.

# --- Real LLM providers (leave blank to stay in mock mode) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5

# --- Retry / timeout tuning ---
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES_PER_PROVIDER=2
LLM_RETRY_BACKOFF_SECONDS=1.5

# --- LangSmith cost/latency tracing (REQUIRED) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Project created at startup if it doesn't exist yet.
LANGSMITH_PROJECT=support-bot
# EU-hosted LangSmith accounts must set this -- the SDK defaults to the
# US endpoint, so traces will silently fail to authenticate without it.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Storage ---
SUPPORT_BOT_DB_PATH=support_bot.db
SUPPORT_BOT_FALLBACK_LOG=fallback_log.jsonl

# --- Knowledge base matching ---
KB_MATCH_MIN_SCORE=0.15
