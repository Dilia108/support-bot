# Copy this file to .env and fill it in.
# LANGSMITH_API_KEY is REQUIRED -- the bot will not start without it.
# The LLM provider keys are optional: without them the bot uses MockProvider.

# --- Real LLM providers (leave blank to stay in mock mode) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5

# --- Retry / timeout tuning ---
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES_PER_PROVIDER=2
LLM_RETRY_BACKOFF_SECONDS=1.5

# --- LangSmith cost/latency tracing (REQUIRED) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Project created at startup if it doesn't exist yet.
LANGSMITH_PROJECT=support-bot
# EU-hosted LangSmith accounts must set this -- the SDK defaults to the
# US endpoint, so traces will silently fail to authenticate without it.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Web chat (python web_app.py) ---
SUPPORT_BOT_WEB_PORT=5000

# --- Channel API for Botpress etc. (python bot_api.py) ---
# Random secret, at least 20 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPPORT_BOT_API_KEY=
SUPPORT_BOT_API_PORT=5001
SUPPORT_BOT_API_MAX_REQUESTS_PER_MINUTE=30

# --- Conversation ---
# Questions in a row without a knowledge base answer before handing over to a person
SUPPORT_BOT_MAX_CONSECUTIVE_GAPS=2

# --- Storage ---
SUPPORT_BOT_DB_PATH=support_bot.db
SUPPORT_BOT_FALLBACK_LOG=fallback_log.jsonl

# --- Knowledge base search ---
# vector  = LangChain + Chroma, matching by meaning (downloads a ~220 MB
#           model on first start). keyword = word matching only.
# hybrid  = keyword first, vector search when keyword finds nothing.
SUPPORT_BOT_RETRIEVER=hybrid
# full = compare with heading + text; max = best of heading alone / heading + text
SUPPORT_BOT_VECTOR_SCORING=max
SUPPORT_BOT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Similarity (0-1) an entry needs to count as a match; below it = KB gap.
# Calibrate with: python tests/evaluate_retrieval.py
SUPPORT_BOT_VECTOR_MIN_SCORE=0.55
# Threshold for the keyword fallback
KB_MATCH_MIN_SCORE=0.15
